# Local development — copy to backend/.env (scripts/dev-local.sh does this automatically).
NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://manupos:localdev@127.0.0.1:5432/manupos
JWT_SECRET=local-dev-jwt-secret-change-in-production
JWT_EXPIRY=24h

CORS_ALLOW_ALL=true
DOMAIN=rebornsense.com
PUBLIC_APP_URL=http://127.0.0.1:5173
MERCHANT_DASHBOARD_URL=http://127.0.0.1:5173
SUPERADMIN_URL=http://127.0.0.1:5173
WEB_SHOP_URL=http://127.0.0.1:5173

