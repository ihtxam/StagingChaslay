DOMAIN=chaslay.com
ACME_EMAIL=admin@webprintmedia.swiss
PUBLIC_APP_URL=https://app.chaslay.com

POSTGRES_DB=manupos
POSTGRES_USER=manupos
POSTGRES_PASSWORD=replace-with-strong-db-password

JWT_SECRET=replace-with-long-random-secret
JWT_EXPIRY=24h
CORS_ALLOW_ALL=true

SEED_SUPERADMIN_EMAIL=admin@chaslay.com
SEED_SUPERADMIN_PASSWORD=ChaslayAdmin123!
SEED_SUPERADMIN_NAME=Chaslay Admin

# Optional integrations (fallback; prefer merchant panel Adyen credentials)
ADYEN_API_KEY=
ADYEN_MERCHANT_ACCOUNT=
ADYEN_CLIENT_ID=
# Platform subscription billing (Superadmin → Settings → Payment). Use these instead of ADYEN_* for subscriptions.
PLATFORM_ADYEN_API_KEY=
PLATFORM_ADYEN_MERCHANT_ACCOUNT=
PLATFORM_ADYEN_CLIENT_KEY=
PLATFORM_ADYEN_ENVIRONMENT=TEST
# Brevo (preferred for merchant invite emails)
BREVO_API_KEY=
BREVO_FROM_EMAIL=noreply@chaslay.com
BREVO_FROM_NAME=Chaslay
# Aliases also supported: SENDINBLUE_API_KEY, SIB_API_KEY, FROM_EMAIL

SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@webprintmedia.swiss

# Point a wildcard DNS A/AAAA record *.DOMAIN at this host for shop subdomains
# Path shops always work: https://DOMAIN/shop/{slug}
PUBLIC_RECEIPT_BASE_URL=https://pay.chaslay.com

# Storekeeper — optional custom barcode product API (Open Food Facts is used when unset)
# BARCODE_LOOKUP_URL=https://your-api.example.com/products/{barcode}
# BARCODE_LOOKUP_API_KEY=
# BARCODE_LOOKUP_NAME_PATH=name,product_name
# BARCODE_LOOKUP_CATEGORY_PATH=category
# BARCODE_LOOKUP_WEIGHT_PATH=weight,weight_grams
# BARCODE_LOOKUP_UNIT_PATH=unit
