{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chaslay POS",
  "version": "0.1.0",
  "identifier": "com.chaslay.pos",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5173"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "shortDescription": "Chaslay Windows POS",
    "longDescription": "Fullscreen kiosk for Chaslay / Reborn WebPOS. Hardware still uses the Print Agent on 127.0.0.1:9101 (Phase C will sidecar it)."
  },
  "plugins": {}
}
