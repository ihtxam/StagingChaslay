{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RebornPOS",
  "version": "0.1.1",
  "identifier": "com.reborn.pos",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5173"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": [
      "binaries/reborn-print-agent"
    ],
    "resources": [
      "resources/win-raw-print.ps1"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "shortDescription": "RebornPOS Windows kiosk",
    "longDescription": "Kiosk shell for Reborn WebPOS with bundled Print Agent sidecar on 127.0.0.1:9101."
  },
  "plugins": {}
}
