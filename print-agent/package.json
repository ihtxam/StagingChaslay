{
  "name": "reborn-print-agent",
  "version": "1.10.0",
  "private": true,
  "description": "Local print service for Reborn - silent ESC/POS to Windows default printer",
  "main": "server.js",
  "bin": "server.js",
  "scripts": {
    "start": "node server.js",
    "build:exe": "pkg . --targets node18-win-x64 --output dist/reborn-print-agent.exe",
    "build:setup": "pkg . --targets node18-win-x64 --output dist/reborn-print-agent-setup.exe",
    "build:installer": "powershell -NoProfile -ExecutionPolicy Bypass -File ./build-installer.ps1",
    "test": "node --test test/*.test.mjs"
  },
  "pkg": {
    "assets": [
      "win-raw-print.ps1",
      "win-raw-print-worker.ps1",
      "win-niimbot-print.ps1",
      "win-scale-read.ps1",
      "aclas-scale.js",
      "niimbot-client.js"
    ],
    "targets": [
      "node18-win-x64"
    ],
    "outputPath": "dist"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "pkg": "^5.8.1"
  }
}
