:80 {
	encode gzip zstd
	root * /srv

	# OpenPage builder (iframe) — keep SPA fallback inside /openpage/, never the dashboard shell
	handle /openpage/* {
		try_files {path} /openpage/index.html
		file_server
	}
	handle /openpage {
		redir * /openpage/ permanent
	}

	# Never cache the app shell or service worker — clients must pick up deploys immediately.
	# Include /pos.webmanifest (installed WebPOS) and SPA fallbacks like /merchant/pos.
	@shell path /index.html /sw.js /manifest.webmanifest /pos.webmanifest /kiosk.webmanifest /order-center.webmanifest
	header @shell Cache-Control "no-cache, no-store, must-revalidate"
	header @shell Pragma "no-cache"

	# Hashed Vite bundles must 404 when missing — never SPA-fallback to HTML
	# (that made shop.chaslay.com look like the Reborn POS offline shell).
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		# / and /merchant/pos serve index.html via try_files; @shell only matches
		# the literal /index.html path, so tills would keep a cached POS shell.
		header Cache-Control "no-cache, no-store, must-revalidate"
		header Pragma "no-cache"
		try_files {path} /index.html
		file_server
	}
}
