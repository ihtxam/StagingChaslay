:80 {
	encode gzip zstd
	root * /srv

	# OpenPage builder (iframe) — keep SPA fallback inside /openpage/, never the dashboard shell
	handle /openpage/* {
		try_files {path} /openpage/index.html
		file_server
	}
	handle /openpage {
		redir * /openpage/ permanent
	}

	# Hashed Vite bundles must 404 when missing — never SPA-fallback to HTML
	# (that made shop.chaslay.com look like the Reborn POS offline shell).
	handle /assets/* {
		file_server
	}

	handle {
		try_files {path} /index.html
		file_server
	}
}
