{
	email {$ACME_EMAIL}
	on_demand_tls {
		ask http://api:3000/api/shop/tls-ask
	}
}

# Reborn production — same API paths as before (/api, /v1). Login on app.rebornsense.com.

app.rebornsense.com {
	handle /receipt/* {
		redir https://pay.rebornsense.com{uri} permanent
	}

	handle /receipts/* {
		redir https://pay.rebornsense.com{uri} permanent
	}

	handle /downloads/* {
		reverse_proxy api:3000
	}

	encode gzip zstd

	handle /health {
		reverse_proxy api:3000
	}

	handle /api/* {
		reverse_proxy api:3000
	}

	handle /v1/* {
		reverse_proxy api:3000
	}

	handle {
		reverse_proxy dashboard:80
	}
}

# API alias — same backend as app (paths unchanged)
api.rebornsense.com {
	handle /downloads/* {
		reverse_proxy api:3000
	}

	encode gzip zstd

	handle /health {
		reverse_proxy api:3000
	}

	handle /v1/* {
		reverse_proxy api:3000
	}

	handle /api/* {
		reverse_proxy api:3000
	}

	handle /receipt/* {
		reverse_proxy dashboard:80
	}

	handle {
		reverse_proxy api:3000
	}
}

shop.rebornsense.com {
	encode gzip zstd

	handle /api/* {
		reverse_proxy api:3000
	}

	handle {
		reverse_proxy dashboard:80
	}
}

pay.rebornsense.com {
	encode gzip zstd

	handle /api/* {
		reverse_proxy api:3000
	}

	handle /receipt/* {
		reverse_proxy dashboard:80
	}

	handle /receipts/* {
		reverse_proxy dashboard:80
	}

	handle {
		reverse_proxy dashboard:80
	}
}

status.rebornsense.com {
	encode gzip zstd

	handle /health {
		reverse_proxy api:3000
	}

	handle /api/* {
		reverse_proxy api:3000
	}

	handle {
		reverse_proxy dashboard:80
	}
}

rebornsense.com www.rebornsense.com {
	redir https://app.rebornsense.com{uri} permanent
}

# Merchant shops: https://{subdomain}.rebornsense.com
*.rebornsense.com {
	tls {
		on_demand
	}

	encode gzip zstd

	handle /api/* {
		reverse_proxy api:3000
	}

	handle {
		reverse_proxy dashboard:80
	}
}

# Custom merchant domains (CNAME → shop.rebornsense.com)
https:// {
	tls {
		on_demand
	}

	encode gzip zstd

	handle /api/* {
		reverse_proxy api:3000
	}

	handle {
		reverse_proxy dashboard:80
	}
}

# --- Legacy Chaslay hosts (point old DNS here during cutover) ---
api.chaslay.com {
	redir https://app.rebornsense.com{uri} permanent
}

app.chaslay.com {
	redir https://app.rebornsense.com{uri} permanent
}

admin.chaslay.com {
	redir https://app.rebornsense.com{uri} permanent
}

shop.chaslay.com {
	redir https://shop.rebornsense.com{uri} permanent
}

pay.chaslay.com {
	redir https://pay.rebornsense.com{uri} permanent
}

status.chaslay.com {
	redir https://status.rebornsense.com{uri} permanent
}
