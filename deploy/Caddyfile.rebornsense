{
	email admin@rebornsense.com
	on_demand_tls {
		ask http://api:3000/api/shop/tls-ask
	}
}

# Reborn production — ManuPOS stack + Android /v1 API
api.rebornsense.com {
	handle /downloads/* {
		reverse_proxy api:3000
	}

	encode gzip zstd

	handle /health {
		reverse_proxy api:3000
	}

	handle /v1/receipts* {
		reverse_proxy api:3000
	}

	handle /v1/* {
		reverse_proxy api:3000
	}

	handle /api/* {
		reverse_proxy api:3000
	}

	handle /receipt/* {
		reverse_proxy dashboard:80
	}

	handle {
		reverse_proxy api:3000
	}
}

app.rebornsense.com {
	handle /receipt/* {
		redir https://pay.rebornsense.com{uri} permanent
	}

	handle /receipts/* {
		redir https://pay.rebornsense.com{uri} permanent
	}

	handle /downloads/* {
		reverse_proxy api:3000
	}

	encode gzip zstd

	handle /api/* {
		reverse_proxy api:3000
	}

	handle /v1/* {
		reverse_proxy api:3000
	}

	handle /receipt/* {
		reverse_proxy dashboard:80
	}

	handle /receipts/* {
		reverse_proxy dashboard:80
	}

	handle {
		reverse_proxy dashboard:80
	}
}

admin.rebornsense.com {
	redir https://app.rebornsense.com{uri} permanent
}

shop.rebornsense.com {
	encode gzip zstd

	handle /api/* {
		reverse_proxy api:3000
	}

	handle {
		reverse_proxy dashboard:80
	}
}

pay.rebornsense.com {
	encode gzip zstd

	handle /api/* {
		reverse_proxy api:3000
	}

	handle /receipt/* {
		reverse_proxy dashboard:80
	}

	handle /receipts/* {
		reverse_proxy dashboard:80
	}

	handle {
		reverse_proxy dashboard:80
	}
}

status.rebornsense.com {
	encode gzip zstd

	handle /health {
		reverse_proxy api:3000
	}

	handle /api/* {
		reverse_proxy api:3000
	}

	handle {
		reverse_proxy dashboard:80
	}
}

*.rebornsense.com {
	tls {
		on_demand
	}

	encode gzip zstd

	handle /api/* {
		reverse_proxy api:3000
	}

	handle {
		reverse_proxy dashboard:80
	}
}

https:// {
	tls {
		on_demand
	}

	encode gzip zstd

	handle /api/* {
		reverse_proxy api:3000
	}

	handle {
		reverse_proxy dashboard:80
	}
}
