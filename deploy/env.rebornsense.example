# Rebornsense production (91.98.41.165) — copy to /root/chaslay-secrets/.env.production
DOMAIN=rebornsense.com
ACME_EMAIL=admin@rebornsense.com
CADDYFILE=./deploy/Caddyfile.rebornsense
PUBLIC_APP_URL=https://app.rebornsense.com
PUBLIC_RECEIPT_BASE_URL=https://pay.rebornsense.com
# Customer shop hub: order.rebornsense.com/{slug}
SHOP_PUBLIC_HOST=order.rebornsense.com
#
# DNS (configure at your DNS provider — required for customer shop URLs):
#   order.rebornsense.com  A  91.98.41.165

POSTGRES_DB=manupos
POSTGRES_USER=manupos
POSTGRES_PASSWORD=replace-with-strong-db-password

JWT_SECRET=replace-with-long-random-secret
JWT_EXPIRY=24h
CORS_ALLOW_ALL=true

SEED_SUPERADMIN_EMAIL=admin@rebornsense.com
SEED_SUPERADMIN_PASSWORD=ChangeMeNow!123
SEED_SUPERADMIN_NAME=Reborn Admin

PLATFORM_EMAIL_PRIMARY=mailco
MAILCO_API_KEY=
MAILCO_FROM_EMAIL=noreply@rebornsense.com
MAILCO_FROM_NAME=Reborn
MAILCO_API_BASE=https://ees.mailco.ch/api/v1
MAILCO_TEMPLATE_SLUG=platform-transactional
# Set to 1 only for outage-only Brevo fallback when mailco is primary (default: off — fail loud)
# MAILCO_BREVO_FALLBACK=0
BREVO_API_KEY=
BREVO_FROM_EMAIL=noreply@rebornsense.com
BREVO_FROM_NAME=Reborn
