# Adyen POS Mobile SDK keys for Bridge Reborn Tap-to-Pay APK build.
# Copy to /root/chaslay-secrets/adyen-sdk.env on the staging/production VPS.
# These are NOT the same as ADYEN_API_KEY (backend web payments).
#
# ADYEN_SDK_API_KEY_TEST=<from Adyen Customer Area → POS Mobile SDK>
# ADYEN_SDK_API_KEY_LIVE=<optional live POS Mobile SDK key>
# ADYEN_SDK_ENV=test
