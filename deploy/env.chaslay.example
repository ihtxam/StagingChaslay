# Chaslay test/staging (116.202.26.15) — copy to /root/chaslay-secrets/.env.production
DOMAIN=chaslay.com
ACME_EMAIL=admin@chaslay.com
CADDYFILE=./deploy/Caddyfile.chaslay
PUBLIC_APP_URL=https://app.chaslay.com
PUBLIC_RECEIPT_BASE_URL=https://pay.chaslay.com
# Customer shop hub: shop.chaslay.com/{slug} (order.chaslay.com not available)
SHOP_PUBLIC_HOST=shop.chaslay.com
#
# DNS (configure at your DNS provider — required for customer shop URLs):
#   shop.chaslay.com  A  116.202.26.15

POSTGRES_DB=manupos
POSTGRES_USER=manupos
POSTGRES_PASSWORD=replace-with-strong-db-password

JWT_SECRET=replace-with-long-random-secret
JWT_EXPIRY=24h
CORS_ALLOW_ALL=true

SEED_SUPERADMIN_EMAIL=admin@chaslay.com
SEED_SUPERADMIN_PASSWORD=ChaslayAdmin123!
SEED_SUPERADMIN_NAME=Chaslay Admin

PLATFORM_EMAIL_PRIMARY=mailco
MAILCO_API_KEY=
MAILCO_FROM_EMAIL=noreply@chaslay.com
MAILCO_FROM_NAME=Chaslay
MAILCO_API_BASE=https://ees.mailco.ch/api/v1
MAILCO_TEMPLATE_SLUG=platform-transactional
BREVO_API_KEY=
BREVO_FROM_EMAIL=noreply@chaslay.com
BREVO_FROM_NAME=Chaslay

# POS Mobile SDK keys for Bridge APK (Tap to Pay). Separate from ADYEN_API_KEY above.
# Without these, deploy builds a print-only APK (see scripts/deploy-hetzner.sh).
# ADYEN_SDK_API_KEY_TEST is accepted as an alias for ADYEN_SDK_API_KEY.
ADYEN_SDK_API_KEY=
ADYEN_SDK_API_KEY_TEST=
ADYEN_SDK_API_KEY_LIVE=
ADYEN_SDK_ENV=test
