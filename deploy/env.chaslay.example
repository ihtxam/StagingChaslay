# Chaslay test/staging (116.202.26.15) — copy to /root/chaslay-secrets/.env.production
DOMAIN=chaslay.com
ACME_EMAIL=admin@chaslay.com
CADDYFILE=./deploy/Caddyfile.chaslay
PUBLIC_APP_URL=https://app.chaslay.com
PUBLIC_RECEIPT_BASE_URL=https://pay.chaslay.com
# Shop hub for path shops (default: shop.chaslay.com/{slug})
# SHOP_PUBLIC_HOST=shop.chaslay.com
#
# DNS (configure at your DNS provider — required for customer shop URLs):
#   shop.chaslay.com  A  116.202.26.15

POSTGRES_DB=manupos
POSTGRES_USER=manupos
POSTGRES_PASSWORD=replace-with-strong-db-password

JWT_SECRET=replace-with-long-random-secret
JWT_EXPIRY=24h
CORS_ALLOW_ALL=true

SEED_SUPERADMIN_EMAIL=admin@chaslay.com
SEED_SUPERADMIN_PASSWORD=ChaslayAdmin123!
SEED_SUPERADMIN_NAME=Chaslay Admin

BREVO_API_KEY=
BREVO_FROM_EMAIL=noreply@chaslay.com
BREVO_FROM_NAME=Chaslay
